# Application
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
TRUST_PROXY=true
# Extra CSRF origins (comma-separated)
# APP_ALLOWED_ORIGINS=

# PostgreSQL
DATABASE_URL=postgresql://cloudora:cloudora@localhost:5432/cloudora?schema=public
POSTGRES_USER=cloudora
POSTGRES_PASSWORD=cloudora
POSTGRES_DB=cloudora

# Must be at least 32 characters. Prefer 64 hex chars (32 bytes).
SESSION_SECRET=change-me-to-a-long-random-session-secret
ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
SESSION_DAYS=7
# COOKIE_SECURE=false

# Runtime: native systemd
# CLOUDORA_RUNTIME=native

# Storage
# Absoluter Pfad, den der Prozess schreibt (z. B. /opt/cloudora/storage)
CLOUDORA_STORAGE_PATH=./storage
# Unterordner relativ zum Storage-Root
CLOUDORA_USERS_DIR=users
CLOUDORA_SHARED_DIR=shared
# Optional per-upload cap in bytes (default 32 GiB)
MAX_UPLOAD_BYTES=34359738368
# Ordner-ZIP: max. Dateien und Bytes (Default 5000 / 8 GiB)
# MAX_ZIP_FILES=5000
# MAX_ZIP_BYTES=8589934592

# Bootstrap admin created by `npx prisma db seed`
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme-now
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# GitHub self-update
CLOUDORA_REPO=MarcelRuh/cloudora
CLOUDORA_BRANCH=main
# Host-Pfad des Installations-Checkouts (Self-Update)
CLOUDORA_INSTALL_DIR=/opt/cloudora
# Optional: GitHub token to avoid anonymous rate limits
# GITHUB_TOKEN=

[Unit]
Description=Cloudora
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/cloudora
Environment=NODE_ENV=production
Environment=CLOUDORA_RUNTIME=native
EnvironmentFile=-/opt/cloudora/.env
ExecStart=/opt/cloudora/scripts/cloudora-run.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
